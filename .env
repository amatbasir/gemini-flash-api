# ==============================================================================
# Express.js Server Configuration
# ==============================================================================

# Port on which the Express server will run.
# Default is 3000 if not specified.
PORT=3000

# Node.js environment. Useful for conditional logic (e.g., logging levels).
# Common values: development, production, test
NODE_ENV=development

# ==============================================================================
# Gemini API Configuration
# ==============================================================================

# Your Google Cloud / Gemini API Key.
# IMPORTANT: Never commit this file to version control (e.g., Git)!
# Get yours from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=[Put your API Key here]

# The Gemini model name you want to use.
# For Gemini Flash, common options are:
# - gemini-1.5-flash-latest (recommended for general use)
# - gemini-1.5-flash
# - gemini-pro (if you want to switch to the "pro" model for comparison/testing)
GEMINI_MODEL_NAME=gemini-1.5-flash-latest

# Optional: Base URL for the Gemini API.
# Only change this if you are using a proxy or a custom endpoint.
# The default is usually sufficient.
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# ==============================================================================
# Optional: Generation Configuration Parameters (for LLM output)
# These values influence the quality and randomness of the model's responses.
# ==============================================================================

# Controls the randomness of the output. Higher values mean more random, creative output.
# Recommended range: 0.0 to 1.0 (0.7 is a good starting point for creative tasks)
GEMINI_TEMPERATURE=0.7

# Controls the diversity of the output. Higher values mean more diverse output.
# Recommended range: 0.0 to 1.0 (0.95 is often a good default)
GEMINI_TOP_P=0.95

# Controls the diversity by considering only the top 'k' most likely tokens.
# Recommended range: 1 to ~100 (64 is a common default)
GEMINI_TOP_K=64

# Maximum number of tokens to generate in the response.
# Important for controlling response length and API costs.
# For Gemini Flash, it can be quite high (e.g., 8192 or more depending on context window).
GEMINI_MAX_OUTPUT_TOKENS=8192

# ==============================================================================
# Optional: Project Specific Settings
# ==============================================================================

# A friendly name for your project, useful for logging or identification.
PROJECT_NAME=MyExpressGeminiFlashApp

# Other custom variables can go here
# CUSTOM_SETTING=value
